rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /arrivals/current {
      allow get: if request.auth != null &&
        exists(/databases/$(database)/documents/arrivalReaders/$(request.auth.uid));
      allow create, update: if request.auth != null &&
        !exists(/databases/$(database)/documents/arrivalReaders/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/arrivalPublishers/$(request.auth.uid)) &&
        request.resource.data.keys().hasOnly(['month', 'areas', 'customers', 'updatedAt']) &&
        request.resource.data.month is string &&
        request.resource.data.areas is list &&
        request.resource.data.customers is list &&
        request.resource.data.updatedAt is timestamp;
    }
  }
}
